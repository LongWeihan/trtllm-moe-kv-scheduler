diff --git a/cpp/include/tensorrt_llm/batch_manager/moeKvSchedulingPolicy.h b/cpp/include/tensorrt_llm/batch_manager/moeKvSchedulingPolicy.h
new file mode 100644
index 0000000..a179796
--- /dev/null
+++ b/cpp/include/tensorrt_llm/batch_manager/moeKvSchedulingPolicy.h
@@ -0,0 +173 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#pragma once
+
+#include "tensorrt_llm/runtime/common.h"
+
+#include <algorithm>
+#include <cstdint>
+#include <cstdlib>
+#include <optional>
+
+namespace tensorrt_llm::batch_manager::moe_kv_sched
+{
+
+using tensorrt_llm::runtime::SizeType32;
+
+static constexpr std::uint64_t kPackedHintMagic = 0x4D2ULL;
+static constexpr int kPackedHintMagicShift = 52;
+static constexpr std::uint64_t kPackedHintMask = (1ULL << 10) - 1ULL;
+
+struct Hint
+{
+    SizeType32 pressure{0};
+    SizeType32 reuseGroup{0};
+    SizeType32 sharedPrefixTokens{0};
+    SizeType32 estimatedKvBlocks{0};
+    SizeType32 expectedReuseCount{0};
+    SizeType32 signalSource{0};
+};
+
+struct Config
+{
+    bool telemetryEnabled{false};
+    bool admissionEnabled{false};
+    bool retentionEnabled{false};
+    SizeType32 highWatermarkPct{75};
+    double weightReuse{1.0};
+    double weightRecompute{1.0};
+    double weightPressure{1.0};
+    double weightPollution{1.0};
+    double minAdmitUtility{40.0};
+    double deferMargin{20.0};
+    SizeType32 prefixPriorityBase{55};
+    SizeType32 prefixPriorityMax{95};
+    SizeType32 decodePriority{35};
+    SizeType32 durationMs{5000};
+};
+
+inline bool envFlag(char const* name)
+{
+    auto const* value = std::getenv(name);
+    if (value == nullptr)
+    {
+        return false;
+    }
+    return value[0] == '1' || value[0] == 'y' || value[0] == 'Y' || value[0] == 't' || value[0] == 'T';
+}
+
+inline SizeType32 envInt(char const* name, SizeType32 defaultValue)
+{
+    auto const* value = std::getenv(name);
+    if (value == nullptr)
+    {
+        return defaultValue;
+    }
+    char* end = nullptr;
+    auto parsed = std::strtol(value, &end, 10);
+    if (end == value)
+    {
+        return defaultValue;
+    }
+    return static_cast<SizeType32>(std::max<long>(0, parsed));
+}
+
+inline double envDouble(char const* name, double defaultValue)
+{
+    auto const* value = std::getenv(name);
+    if (value == nullptr)
+    {
+        return defaultValue;
+    }
+    char* end = nullptr;
+    auto parsed = std::strtod(value, &end);
+    if (end == value)
+    {
+        return defaultValue;
+    }
+    return parsed;
+}
+
+inline Config configFromEnv()
+{
+    Config config;
+    config.telemetryEnabled = envFlag("TRTLLM_MOE_KV_SCHED_TELEMETRY_ENABLE");
+    config.admissionEnabled = envFlag("TRTLLM_MOE_KV_ADMISSION_ENABLE");
+    config.retentionEnabled = envFlag("TRTLLM_MOE_KV_RETENTION_ENABLE");
+    config.highWatermarkPct = std::clamp(envInt("TRTLLM_MOE_KV_HIGH_WATERMARK_PCT", config.highWatermarkPct), 0, 100);
+    config.weightReuse = envDouble("TRTLLM_MOE_KV_WEIGHT_REUSE", config.weightReuse);
+    config.weightRecompute = envDouble("TRTLLM_MOE_KV_WEIGHT_RECOMPUTE", config.weightRecompute);
+    config.weightPressure = envDouble("TRTLLM_MOE_KV_WEIGHT_PRESSURE", config.weightPressure);
+    config.weightPollution = envDouble("TRTLLM_MOE_KV_WEIGHT_POLLUTION", config.weightPollution);
+    config.minAdmitUtility = envDouble("TRTLLM_MOE_KV_MIN_ADMIT_UTILITY", config.minAdmitUtility);
+    config.deferMargin = envDouble("TRTLLM_MOE_KV_DEFER_MARGIN", config.deferMargin);
+    config.prefixPriorityBase = std::clamp(envInt("TRTLLM_MOE_KV_PREFIX_PRIORITY_BASE", config.prefixPriorityBase), 0, 100);
+    config.prefixPriorityMax = std::clamp(envInt("TRTLLM_MOE_KV_PREFIX_PRIORITY_MAX", config.prefixPriorityMax), 0, 100);
+    config.decodePriority = std::clamp(envInt("TRTLLM_MOE_KV_DECODE_PRIORITY", config.decodePriority), 0, 100);
+    config.durationMs = envInt("TRTLLM_MOE_KV_DURATION_MS", config.durationMs);
+    return config;
+}
+
+inline std::uint64_t packHint(Hint const& hint)
+{
+    auto clamp10 = [](SizeType32 value) -> std::uint64_t { return static_cast<std::uint64_t>(std::clamp(value, 0, 1023)); };
+    return (kPackedHintMagic << kPackedHintMagicShift) | (clamp10(hint.pressure) << 42)
+        | (clamp10(hint.reuseGroup) << 32) | (clamp10(hint.sharedPrefixTokens) << 22)
+        | (clamp10(hint.estimatedKvBlocks) << 12) | (clamp10(hint.expectedReuseCount) << 2)
+        | clamp10(hint.signalSource & 0x3);
+}
+
+inline std::optional<Hint> unpackHint(std::optional<std::uint64_t> packed)
+{
+    if (!packed.has_value())
+    {
+        return std::nullopt;
+    }
+    auto const value = packed.value();
+    if ((value >> kPackedHintMagicShift) != kPackedHintMagic)
+    {
+        return std::nullopt;
+    }
+    Hint hint;
+    hint.pressure = static_cast<SizeType32>((value >> 42) & kPackedHintMask);
+    hint.reuseGroup = static_cast<SizeType32>((value >> 32) & kPackedHintMask);
+    hint.sharedPrefixTokens = static_cast<SizeType32>((value >> 22) & kPackedHintMask);
+    hint.estimatedKvBlocks = static_cast<SizeType32>((value >> 12) & kPackedHintMask);
+    hint.expectedReuseCount = static_cast<SizeType32>((value >> 2) & kPackedHintMask);
+    hint.signalSource = static_cast<SizeType32>(value & 0x3);
+    return hint;
+}
+
+inline SizeType32 kvPressurePct(SizeType32 usedBlocks, SizeType32 maxBlocks)
+{
+    if (maxBlocks <= 0)
+    {
+        return 0;
+    }
+    return std::clamp(static_cast<SizeType32>((static_cast<std::int64_t>(usedBlocks) * 100) / maxBlocks), 0, 100);
+}
+
+inline double cacheUtility(Hint const& hint, SizeType32 promptLen, SizeType32 tokensPerBlock, Config const& config)
+{
+    auto const safeTokensPerBlock = std::max<SizeType32>(1, tokensPerBlock);
+    auto const pressure = std::clamp(hint.pressure, 0, 1000) / 1000.0;
+    auto const prefixBlocks = static_cast<double>(hint.sharedPrefixTokens) / safeTokensPerBlock;
+    auto const estimatedBlocks
+        = static_cast<double>(std::max<SizeType32>(hint.estimatedKvBlocks, (promptLen + safeTokensPerBlock - 1) / safeTokensPerBlock));
+    auto const reuseValue = prefixBlocks * (1.0 + static_cast<double>(hint.expectedReuseCount)) * config.weightReuse;
+    auto const recomputeCost = (static_cast<double>(promptLen) / safeTokensPerBlock) * config.weightRecompute;
+    auto const pressureCost = pressure * (prefixBlocks + recomputeCost) * config.weightPressure;
+    auto const pollutionCost = std::max(0.0, estimatedBlocks - prefixBlocks) * config.weightPollution;
+    return reuseValue + recomputeCost + pressureCost - pollutionCost;
+}
+
+inline SizeType32 utilityToPriority(double utility, Config const& config)
+{
+    auto const clamped = std::clamp(utility, 0.0, 100.0);
+    auto const span = static_cast<double>(config.prefixPriorityMax - config.prefixPriorityBase);
+    return std::clamp(static_cast<SizeType32>(config.prefixPriorityBase + (clamped / 100.0) * span), 0, 100);
+}
+
+} // namespace tensorrt_llm::batch_manager::moe_kv_sched
