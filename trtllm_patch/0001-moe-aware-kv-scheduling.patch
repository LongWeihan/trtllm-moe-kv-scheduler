+bool moeKvAdmissionActive(kv_cache_manager::BaseKVCacheManager const& kvCacheManager, moe_kv_sched::Config const& config)
+{
+    if (!config.admissionEnabled)
+    {
+        return false;
+    }
+    auto const maxBlocks = kvCacheManager.getMaxNumBlocks();
+    auto const usedBlocks = kvCacheManager.getUsedNumBlocks();
+    auto const pressurePct = moe_kv_sched::kvPressurePct(usedBlocks, maxBlocks);
+    return pressurePct >= config.highWatermarkPct;
+}
+
+bool schedulableFirstContextRequest(std::shared_ptr<LlmRequest> const& req)
+{
+    return req->isContextInitState() && req->isFirstContextChunk() && !req->isDisaggGenerationInitState();
+}
+
+double requestCacheUtility(
+    std::shared_ptr<LlmRequest> const& req, kv_cache_manager::BaseKVCacheManager const& kvCacheManager,
+    moe_kv_sched::Config const& config)
+{
+    auto const hint = moe_kv_sched::unpackHint(req->getClientId());
+    if (!hint.has_value())
+    {
+        return 0.0;
+    }
+    return moe_kv_sched::cacheUtility(*hint, req->getPromptLen(), kvCacheManager.getTokensPerBlock(), config);
+}
+
+bool shouldDeferForMoeKvScheduling(std::shared_ptr<LlmRequest> const& req, RequestList::const_iterator nextIt,
+    RequestList::const_iterator endIt, kv_cache_manager::BaseKVCacheManager const& kvCacheManager,
+    moe_kv_sched::Config const& config)
+{
+    if (!moeKvAdmissionActive(kvCacheManager, config) || !schedulableFirstContextRequest(req))
+    {
+        return false;
+    }
+
+    auto const utility = requestCacheUtility(req, kvCacheManager, config);
+    if (utility >= config.minAdmitUtility)
+    {
+        return false;
+    }
+
+    for (auto it = nextIt; it != endIt; ++it)
+    {
+        auto const& laterReq = *it;
+        if (!schedulableFirstContextRequest(laterReq))
+        {
+            continue;
+        }
+        auto const laterUtility = requestCacheUtility(laterReq, kvCacheManager, config);
+        if (laterUtility >= config.minAdmitUtility && laterUtility > utility + config.deferMargin)
+        {
+            if (config.telemetryEnabled)
+            {
+                TLLM_LOG_INFO(
+                    "MoE KV admission defer request=%lu utility=%.2f for later_request=%lu later_utility=%.2f",
+                    req->mRequestId, utility, laterReq->mRequestId, laterUtility);
+            }
+            return true;
+        }
+    }
+    return false;
+}
+
+void sortPendingByMoeKvUtilityIfActive(
+    RequestVector& pendingRequests, kv_cache_manager::BaseKVCacheManager const& kvCacheManager,
+    moe_kv_sched::Config const& config)
+{
+    if (!moeKvAdmissionActive(kvCacheManager, config))
+    {
+        return;
+    }
+    std::stable_sort(pendingRequests.begin(), pendingRequests.end(),
+        [&kvCacheManager, &config](auto const& lhs, auto const& rhs)
+        { return requestCacheUtility(lhs, kvCacheManager, config) > requestCacheUtility(rhs, kvCacheManager, config); });
+}
