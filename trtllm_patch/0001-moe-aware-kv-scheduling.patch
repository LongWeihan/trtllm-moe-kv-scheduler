+std::optional<tle::KvCacheRetentionConfig> resolveMoeKvRetentionConfig(
+    tensorrt_llm::batch_manager::LlmRequest const& llmRequest, SizeType32 inputLength, SizeType32 tokensPerBlock)
+{
+    auto explicitConfig = llmRequest.getKvCacheRetentionConfig();
+    if (explicitConfig.has_value())
+    {
+        return explicitConfig;
+    }
+
+    auto const config = tensorrt_llm::batch_manager::moe_kv_sched::configFromEnv();
+    if (!config.retentionEnabled)
+    {
+        return std::nullopt;
+    }
+
+    auto const hint = tensorrt_llm::batch_manager::moe_kv_sched::unpackHint(llmRequest.getClientId());
+    if (!hint.has_value() || hint->sharedPrefixTokens <= 0)
+    {
+        return std::nullopt;
+    }
+
+    auto const utility = tensorrt_llm::batch_manager::moe_kv_sched::cacheUtility(
+        *hint, llmRequest.getPromptLen(), tokensPerBlock, config);
+    auto const priority = tensorrt_llm::batch_manager::moe_kv_sched::utilityToPriority(utility, config);
+    auto const tokenEnd = std::min<SizeType32>(inputLength, std::max<SizeType32>(tokensPerBlock, hint->sharedPrefixTokens));
+    std::vector<tle::KvCacheRetentionConfig::TokenRangeRetentionConfig> ranges;
+    ranges.emplace_back(0, tokenEnd, priority, std::chrono::milliseconds(config.durationMs));
+
+    if (config.telemetryEnabled)
+    {
+        TLLM_LOG_INFO("MoE KV retention request=%lu utility=%.2f tokenEnd=%d priority=%d", llmRequest.mRequestId,
+            utility, tokenEnd, priority);
+    }
+
+    return tle::KvCacheRetentionConfig(
+        ranges, config.decodePriority, std::chrono::milliseconds(config.durationMs));
+}
